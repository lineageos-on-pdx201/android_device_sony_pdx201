binder_call(hal_miscta_client, hal_miscta_server)
binder_call(hal_miscta_server, hal_miscta_client)

add_hwservice(hal_miscta_server, hal_miscta_hwservice)
add_service(hal_miscta_server, hal_miscta_service)
allow hal_miscta_client hal_miscta_hwservice:hwservice_manager find;
allow hal_miscta_client hal_miscta_service:service_manager find;
